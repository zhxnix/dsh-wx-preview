page {
  background: #f4f8f5;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 40rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(24, 80, 48, 0.12);
}

.eyebrow {
  color: #22945c;
  font-size: 24rpx;
}

.title {
  color: #173d29;
  font-size: 48rpx;
  font-weight: 700;
}

.message {
  color: #527060;
  font-size: 30rpx;
}

button {
  margin-top: 18rpx;
  background: #35b66d;
  color: #fff;
}
